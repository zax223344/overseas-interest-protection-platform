{
  "name": "orps-backend",
  "version": "2.0.0",
  "description": "海外利益保护情报预警平台 - PostgreSQL 后端服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-data.js",
    "pm2:start": "pm2 start server.js --name orps-backend",
    "pm2:stop": "pm2 stop orps-backend",
    "pm2:restart": "pm2 restart orps-backend"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  }
}
