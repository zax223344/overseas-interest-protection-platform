# 数据库连接
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orps_db
DB_USER=orps_user
DB_PASS=your_secure_password_here

# JWT
JWT_SECRET=change_this_to_a_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=24h

# 服务器
PORT=3000
NODE_ENV=production

# 前端地址 (CORS)
CORS_ORIGIN=http://localhost:8080

# ===== 翻译增强（可选，配置后解除 MyMemory 每日 5000 字符配额限制）=====
# 百度翻译开放平台 APPID / 密钥（免费 200 万字符/月，全语向）
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_KEY=
# MyMemory 免费注册 key（仍免费、非百度）：注册账号后凭 user/pass 调用 POST /api/translate/mymemory-key 获取，
# 写入后免费配额从 5000 字符/日升至 50000 字符/日
MYMEMORY_KEY=

# ===== AgentKey 连接器上游密钥（可选，配置后启用实时深度采集）=====
AGENTKEY_SERPER_KEY=
AGENTKEY_TAVILY_KEY=
AGENTKEY_BRAVE_KEY=
AGENTKEY_EXA_KEY=
AGENTKEY_FIRECRAWL_KEY=
AGENTKEY_JINA_KEY=
